{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerDatasetsEntrenamiento",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::tiendaia-datos/datasets/*"
    },
    {
      "Sid": "EscribirModelosEntrenados",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::tiendaia-datos/modelos/*"
    }
  ]
}
